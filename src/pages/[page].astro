---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import {getContent} from '../lib/content/repository';
export function getStaticPaths(){return ['pierwszy-trening','cennik','dzieci','kobiety','klub','kontakt','faq','polityka-prywatnosci','regulamin'].map(page=>({params:{page}}));}
const page=Astro.params.page!;const c=getContent();
const info:Record<string,[string,string]>={
 'pierwszy-trening':['Twój pierwszy trening.','Nie musisz mieć doświadczenia. Wybierz grupę INTRO i zrób pierwszy krok na matę.'],
 cennik:['Wybierz swój rytm.','Jedno wejście czy regularne treningi? Sprawdź karnety WWFC.'],
 dzieci:['Małe kroki. Wielka energia.','Zajęcia dla dzieci i młodzieży. Wybierz grupę dopasowaną do wieku.'],
 kobiety:['Twoja przestrzeń do treningu.','Poznaj grupy dla kobiet i znajdź dyscyplinę dla siebie.'],
 klub:['Warsaw West Fight Club.','Sporty walki i trening ruchowy przy Strzykulskiej 6a w Ożarowie Mazowieckim.'],
 kontakt:['Widzimy się w Ożarowie.','Pomożemy Ci wybrać grupę i przygotować się do pierwszych zajęć.'],
 faq:['Dobre pytania na początek.','Wszystko, co warto ustalić przed pierwszym treningiem.'],
 'polityka-prywatnosci':['Polityka prywatności.','Informacje o przetwarzaniu danych.'],regulamin:['Regulamin.','Zasady korzystania z klubu.']};
const [title,intro]=info[page]!;const group=page==='dzieci'?'children':'women';
const disciplineSlugs=new Set(c.releases.flatMap(r=>r.sessions.filter(s=>s.audience===group).map(s=>s.disciplineSlug)));
const {settings}=c;const tel=settings.phone?.replace(/[^\d+]/g,'');
const addressLine=[settings.address?.postalCode,settings.address?.city].filter(Boolean).join(' ');
const mapQuery=encodeURIComponent([settings.clubName,settings.address?.street,addressLine].filter(Boolean).join(' '));
---
<BaseLayout title={title} description={intro} canonicalPath={`/${page}/`}>
 <PageHead title={title} intro={intro}/><section class="section"><div class="wrap">
 {page==='pierwszy-trening'&&<div class="split"><div><ol class="steps"><li><h3>Znajdź swoją grupę</h3><p>Wybierz w grafiku poziom INTRO. Jeśli szukasz zajęć dla dziecka, sprawdź przedział wiekowy.</p><a href="/grafik/?level=intro">Pokaż grupy INTRO ↗</a></li><li><h3>Przygotuj się</h3><p>Zabierz wygodny strój, wodę i ręcznik. Wymagany sprzęt potwierdź w recepcji — zależy od dyscypliny.</p></li><li><h3>Przyjdź do recepcji</h3><p>{[settings.address?.street,settings.address?.city].filter(Boolean).join(', ')}. Według informacji klubu zajęcia grupowe nie wymagają wcześniejszych zapisów. Zostaw sobie czas na formalności przed treningiem.</p></li></ol></div><aside><h2>Pierwszy raz?<br/>Jesteśmy obok.</h2><p class="lead">Powiedz nam, co chcesz trenować i czy masz już doświadczenie. Pomożemy znaleźć odpowiednią grupę.</p>{settings.phone&&<a class="btn" href={`tel:${tel}`}>Zadzwoń: {settings.phone} ↗</a>}<p class="note" style="margin-top:30px">Aktualne ceny i zasady karnetów znajdziesz w cenniku. Szczegóły pierwszej wizyty potwierdzisz w recepcji.</p><a href="/cennik/">Zobacz pełny cennik ↗</a></aside></div>}
 {page==='cennik'&&(c.pricing?<div><h2>{c.pricing.title}</h2><div class="three">{c.pricing.groups.map(group=><section><h3>{group.name}</h3>{group.description&&<p>{group.description}</p>}<table class="price-table"><caption class="sr-only">{group.name}</caption><tbody>{group.rows.map(row=><tr><th scope="row">{row.label}</th><td>{row.price}{row.note&&<><br/><small>{row.note}</small></>}</td></tr>)}</tbody></table></section>)}</div>{c.pricing.notes.map(note=><p class="note">{note}</p>)}{c.pricing.paymentInformation&&<p>{c.pricing.paymentInformation}</p>}<div class="actions"><a class="btn" href="/grafik/">Wybierz trening ↗</a>{settings.phone&&<a class="btn secondary" href={`tel:${tel}`}>Zapytaj o karnet</a>}</div></div>:<p class="note">Cennik nie został jeszcze opublikowany. Aktualne ceny potwierdzisz w recepcji.</p>)}
 {(page==='dzieci'||page==='kobiety')&&<><div class="split"><div><h2>{page==='dzieci'?'Ruch. Nauka. Zabawa.':'Zacznij po swojemu.'}</h2><p class="lead">{page==='dzieci'?'Westusie, akrobatyka i sporty walki. Grupy w grafiku mają konkretne przedziały wiekowe, dlatego zacznij od wieku dziecka.':'W grafiku znajdziesz osobne grupy boksu i BJJ No-Gi dla kobiet. Sprawdź ich poziom i godziny lub zobacz pełną ofertę klubu.'}</p><a class="btn" href={`/grafik/?audience=${group}`}>Pokaż zajęcia ↗</a></div><div><p class="note">{page==='dzieci'?'Nie wiesz, którą grupę wybrać? Zadzwoń do recepcji. Wiek jest punktem wyjścia — wybór odpowiednich zajęć warto omówić przed pierwszą wizytą.':'Nie wiesz, od czego zacząć? Zapytaj recepcję o pierwszą wizytę i potrzebny sprzęt.'}</p>{settings.phone&&<a href={`tel:${tel}`}>Porozmawiajmy: {settings.phone}</a>}</div></div><div class="three" style="margin-top:50px">{c.disciplines.filter(d=>disciplineSlugs.has(d.slug)).map(d=><article class="path-card"><h3>{d.name}</h3><p>{d.description}</p><a href={`/grafik/?audience=${group}&discipline=${d.slug}`}>Sprawdź grupy ↗</a></article>)}</div></>}
 {page==='klub'&&<div class="split"><div><h2>Wiele dyscyplin.<br/>Wspólna mata.</h2><p class="lead">{settings.clubName??'WWFC'} to klub sportów walki w {settings.address?.city??'Ożarowie Mazowieckim'}. W grafiku są boks, kickboxing, Muay Thai, MMA, BJJ i zapasy, a także zajęcia ruchowe.</p><p>Treningi odbywają się na Matach 1 i 2, w salce oraz strefie cardio. Wybierz grupę INTRO, zajęcia dla dzieci lub swój kolejny poziom.</p><a class="btn" href="/dyscypliny/">Poznaj dyscypliny ↗</a></div><div><h3>Przyjdź, poznaj nas</h3><p>{settings.address?.street}<br/>{addressLine}</p><p>{settings.openingHours.map((row,i)=><>{i>0&&<br/>}{row.label}: {row.hours}</>)}</p><a href="/trenerzy/">Poznaj trenerów ↗</a><div class="contact-block"><a href="/kontakt/">Dojazd i kontakt ↗</a></div></div></div>}
 {page==='kontakt'&&<div class="split"><div><h2>Porozmawiajmy.</h2>{settings.phone&&<div class="contact-block"><p class="eyebrow">Recepcja</p><a href={`tel:${tel}`}>{settings.phone}</a></div>}{settings.email&&<div class="contact-block"><p class="eyebrow">E-mail</p><a href={`mailto:${settings.email}`}>{settings.email}</a></div>}<p style="margin-top:28px">Napisz, jaką dyscypliną i grupą się interesujesz. W wiadomości nie podawaj informacji o zdrowiu ani innych wrażliwych danych.</p></div><div><h3>{settings.address?.street}</h3><p class="lead">{addressLine}</p><p>{settings.openingHours.map((row,i)=><>{i>0&&<br/>}{row.label}: {row.hours}</>)}</p>{mapQuery&&<a class="btn" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener noreferrer">Otwórz trasę w Google Maps ↗</a>}<p class="note" style="margin-top:30px">Na zajęcia grupowe nie obowiązują wcześniejsze zapisy, zgodnie z informacją klubu. Przed pierwszą wizytą sprawdź grupę i potrzebny sprzęt.</p></div></div>}
 {page==='faq'&&<div class="faq content">{c.faq.map(item=><details><summary>{item.question}</summary><p>{item.answer}</p></details>)}<div class="actions"><a class="btn" href="/kontakt/">Masz inne pytanie? Napisz ↗</a></div></div>}
 {(page==='regulamin'||page==='polityka-prywatnosci')&&<div class="content">{c.legal.approved?<div style="white-space:pre-wrap;line-height:1.8">{page==='regulamin'?c.legal.terms:c.legal.privacy}</div>:<><p class="note">Dokument oczekuje na treść zatwierdzoną przez operatora WWFC. Ta wersja strony służy do przeglądu i nie jest gotowa do publikacji produkcyjnej.</p><p>W tej wersji nie uruchomiono formularza zbierającego dane, newslettera ani analityki. Kontakt z recepcją jest dostępny telefonicznie i przez program pocztowy.</p><a href="/kontakt/">Dane kontaktowe klubu ↗</a></>}</div>}
 </div></section>
</BaseLayout>
