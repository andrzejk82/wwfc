---
import BaseLayout from '../layouts/BaseLayout.astro';
import Today from '../components/Today.astro';
import {getContent} from '../lib/content/repository';
const c=getContent();
const address=[c.settings.address?.street,c.settings.address?.city].filter(Boolean).join(' · ');
---
<BaseLayout title="Wejdź na matę" description="Sporty walki w Ożarowie Mazowieckim. Sprawdź grafik WWFC, poznaj trenerów i znajdź swoją grupę — od pierwszego treningu." canonicalPath="/">
 <section class="hero dark"><div class="wrap"><div class="hero-top"><div><p class="eyebrow">{address}</p><h1>Wejdź<br/>na <span>matę.</span></h1><p class="lead">Pierwszy krok, kolejny poziom, własne tempo.<br/>Znajdź swoje miejsce w {c.settings.clubName??'Warsaw West Fight Club'}.</p><div class="actions"><a class="btn" href="/pierwszy-trening/">Mój pierwszy trening ↗</a><a class="btn secondary" href="/grafik/">Sprawdź grafik</a></div></div><div class="hero-media"><img src="/images/jarek-malinowski.webp" alt="Jarek Malinowski, trener kickboxingu" width="640" height="640" fetchpriority="high"/><img src="/images/karolina-owczarz.webp" alt="Karolina Owczarz, trenerka boksu i MMA" width="640" height="640"/><span class="hero-caption">TWOI TRENERZY. TWOJA DRUŻYNA.</span></div></div><div class="hero-footer"><span><strong>OD ZERA DO SWOJEGO POZIOMU</strong></span><span>Dorośli · Dzieci i młodzież · Kobiety</span><span>WARSAW WEST / EST. OŻARÓW</span></div></div></section>
 <div class="ticker orange"><div class="wrap"><span>Boks / Kickboxing</span><span>MMA / BJJ</span><span>Muay Thai / Zapasy</span><span>Ruch / Siła / Mobilność</span></div></div>
 <section class="section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Każdy zaczyna od pierwszego kroku</p><h2>Twoja droga<br/>zaczyna się tutaj.</h2></div><p class="lead" style="max-width:380px">Nie musisz znać wszystkich zasad.<br/>Na początek wybierz grupę dla siebie.</p></div><div class="three"><article class="path-card featured"><span class="number">01 / PIERWSZY RAZ</span><h3>Zaczynam od zera</h3><p>Grupy INTRO, jasny plan pierwszej wizyty i pomoc w wyborze zajęć.</p><a href="/pierwszy-trening/">Zrób pierwszy krok ↗</a></article><article class="path-card"><span class="number">02 / MŁODA DRUŻYNA</span><h3>Dzieci i młodzież</h3><p>Od Westusiów po grupy nastolatków. Znajdź zajęcia odpowiednie do wieku.</p><a href="/dzieci/">Poznaj grupy dziecięce ↗</a></article><article class="path-card"><span class="number">03 / WŁASNE TEMPO</span><h3>Zajęcia dla kobiet</h3><p>Boks, BJJ No-Gi i kolejne możliwości w pełnym grafiku klubu.</p><a href="/kobiety/">Znajdź swoją grupę ↗</a></article></div></div></section>
 <section class="section rule"><div class="wrap split"><div><p class="eyebrow">Trening wpisany w Twój dzień</p><h2>Mniej szukania.<br/>Więcej treningu.</h2><p class="lead">Dyscyplina, poziom, godzina. Sprawdź grafik i wybierz zajęcia, które pasują do Ciebie.</p><p class="muted">Na zajęcia grupowe nie obowiązują wcześniejsze zapisy — zgodnie z informacją klubu.</p></div><Today/></div></section>
 <section class="section dark"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Znajdź swój styl</p><h2>Jedna mata.<br/>Wiele możliwości.</h2></div><a class="btn secondary" href="/dyscypliny/">Wszystkie dyscypliny ↗</a></div><div class="discipline-list">{c.disciplines.filter(d=>['boks','kickboxing','mma','bjj-no-gi','muay-thai','zapasy'].includes(d.slug)).map(d=><a class="discipline-link" href={`/dyscypliny/${d.slug}/`}>{d.name}<span aria-hidden="true">↗</span></a>)}</div></div></section>
 <section class="section"><div class="wrap split"><div><p class="eyebrow">Ludzie tworzą klub</p><h2>Trenuj z ludźmi,<br/>którzy są obok.</h2><p class="lead">Poznaj prowadzących i sprawdź ich grupy. Wybór trenera to dobry początek własnej drogi.</p><a class="btn secondary" href="/trenerzy/">Poznaj całą kadrę ↗</a></div><div class="split coach-grid">{c.coaches.filter(x=>x.image).map(x=><article class="coach-card"><a href={`/trenerzy/${x.slug}/`}><img src={x.image} alt="" width="640" height="640" loading="lazy"/><h3>{x.name}</h3></a><p>{x.description}</p></article>)}</div></div></section>
 <section class="section rule"><div class="wrap split"><div><p class="eyebrow">Przed pierwszą wizytą</p><h2>Masz pytania?<br/>Zacznij tutaj.</h2><a href="/faq/">Wszystkie odpowiedzi ↗</a></div><div class="faq">{c.faq.slice(0,4).map(item=><details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>
 <section class="section orange"><div class="wrap section-heading"><div><p class="eyebrow">{address}</p><h2>Do zobaczenia<br/>na treningu.</h2></div><a class="btn secondary" href="/kontakt/">Znajdź nas ↗</a></div></section>
</BaseLayout>
