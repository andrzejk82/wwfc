{
  "name": "wwfc-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node --import tsx scripts/build.mjs",
    "build:fixture": "node --import tsx scripts/build-fixture.mjs",
    "manifest": "node --import tsx scripts/write-build-manifest.mjs",
    "verify:artifact": "node --import tsx scripts/verify-artifact.mjs",
    "test:production": "playwright test --config playwright.production.config.ts",
    "preview": "astro preview",
    "preview:pages": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "check": "astro check",
    "content:fetch": "node --env-file-if-exists=.env --import tsx scripts/fetch-content.mjs",
    "content:prepare-import": "node --import tsx scripts/prepare-sanity-import.mjs",
    "studio:dev": "npm --prefix studio run dev",
    "studio:build": "npm --prefix studio run build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "test:assets": "playwright test tests/e2e/assets.spec.ts --project=chromium-1440 --workers=1"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@sanity/client": "^8.6.1",
    "astro": "^7.3.2",
    "zod": "^4.5.4"
  },
  "overrides": {
    "lighthouse": "13.4.1",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "qs": "6.16.0",
    "js-yaml@^3.0.0": "3.15.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "groq-js": "^2.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sharp": "0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  }
}
