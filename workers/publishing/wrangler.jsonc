{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wwfc-publishing",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "durable_objects": {"bindings": [{"name": "PUBLICATIONS", "class_name": "PublicationCoordinator"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["PublicationCoordinator"]}],
  "vars": {"DRAFT_PREVIEW_ENABLED": "false"}
}
